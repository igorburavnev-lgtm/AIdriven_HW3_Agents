# Copy to .env and adjust. Every variable is optional - settings.py falls back to
# development defaults (SQLite, DEBUG on, localhost only).

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com

# --- Database ---
# Default: SQLite at BASE_DIR/db.sqlite3. Set DB_ENGINE=postgres for PostgreSQL.
DB_ENGINE=sqlite
# DB_ENGINE=postgres
POSTGRES_DB=investing
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Celery ---
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=false
PRICE_UPDATE_INTERVAL_SECONDS=300

# --- Tinkoff Invest API ---
TINKOFF_TOKEN=
